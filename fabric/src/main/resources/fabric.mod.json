{
  "schemaVersion": 1,
  "id": "palworks",
  "version": "${version}",
  "name": "Palworks",
  "description": "Turns your Cobblemon Pokémon into workers. Send one out and it finds jobs nearby on its own: lighting furnaces, planting and harvesting crops, chopping trees, and carrying items to your chests.",
  "authors": [
    "JohnBPerkins"
  ],
  "contact": {
    "homepage": "https://github.com/JohnBPerkins/Palworks",
    "sources": "https://github.com/JohnBPerkins/Palworks",
    "issues": "https://github.com/JohnBPerkins/Palworks/issues"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.palworks.fabric.PalworksFabric"
    ],
    "client": [
      "dev.palworks.fabric.PalworksFabricClient"
    ]
  },
  "mixins": [
    "palworks.mixins.json"
  ],
  "accessWidener": "palworks.accesswidener",
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*",
    "cobblemon": ">=1.7.0 <1.9"
  }
}
