{
  "schemaVersion": 1,
  "id": "palworks-gametest",
  "version": "1.0.0",
  "name": "Palworks GameTests",
  "description": "In-game tests for Palworks. Dev runs only (./gradlew :fabric:runGameTest); never published.",
  "environment": "*",
  "entrypoints": {
    "fabric-gametest": [
      "dev.palworks.gametest.TreeGameTests",
