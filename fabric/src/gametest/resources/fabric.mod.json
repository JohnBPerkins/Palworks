{
  "schemaVersion": 1,
  "id": "palworks_gametest",
  "version": "1.0.0",
  "name": "Palworks GameTests",
  "description": "In-game tests for Palworks, shared with NeoForge (common/src/gametest). Dev runs only (./gradlew :fabric:runGameTest); never published.",
  "environment": "*",
  "entrypoints": {
    "fabric-gametest": [
      "dev.palworks.gametest.TreeGameTests",
      "dev.palworks.gametest.CropGameTests",
      "dev.palworks.gametest.JobGameTests",
      "dev.palworks.gametest.WorkerGameTests",
      "dev.palworks.gametest.RealTreeGameTests",
      "dev.palworks.gametest.WorkStatusGameTests",
      "dev.palworks.gametest.PickupGameTests",
      "dev.palworks.gametest.TestAreaGameTests",
      "dev.palworks.gametest.HangingFruitGameTests",
      "dev.palworks.gametest.CobblemonCropGameTests",
      "dev.palworks.gametest.PathingGameTests"
    ]
  },
  "depends": {
    "palworks": "*",
    "fabric-gametest-api-v1": "*"
  }
}
